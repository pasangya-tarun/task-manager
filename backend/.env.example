# Application Port
PORT=5000

# MongoDB Atlas Connection URI Template
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER_HOST/task_manager_db?retryWrites=true&w=majority

# Frontend Client URL (for CORS and Cookie Security)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Environment (development, production, test)
NODE_ENV=development

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# JWT Expiration Duration (e.g., 15m, 1h)
JWT_EXPIRES_IN=15m

# Cookie Signing Secret (distinct from JWT_SECRET)
COOKIE_SECRET=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_SECRET

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM="TaskFlow Pro" <noreply@taskflowpro.local>
